# Copy to .env (git-ignored) and fill in. Never commit real values.
# ":80" serves plain HTTP on localhost. On the server this is <ip-with-dashes>.sslip.io.
SITE_HOST=:80
# LLM used by the control layer itself (llm/factory.py): openai | ollama.
# Unset LLM_PROVIDER means openai when OPENAI_API_KEY is set, otherwise local Ollama.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
# Optional: any OpenAI-compatible server, and the local Ollama endpoint/model.
# OPENAI_BASE_URL=https://api.openai.com/v1
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2
# LLM_TIMEOUT_S=60
# Semantic goal-alignment judge in the governed simulation (consume plane), opt-in.
# GOAL_JUDGE=1
# GOAL_JUDGE_SAMPLE_RATE=0.3
# GOAL_JUDGE_PROVIDER=        # overrides LLM_PROVIDER for the judge only
# GOAL_JUDGE_MODEL=
# OpenCode reads the provider's own variable name, and the model as provider/model.
OPENAI_API_KEY=
OPENCODE_MODEL=openai/gpt-4.1-mini
# Required for configuration edits. Generate with: openssl rand -hex 32
# Leave unset/empty to disable browser writes; never commit the generated value.
CONFIG_ADMIN_TOKEN=
# Optional, comma-separated origins for cross-origin browser config edits. Same-origin Compose
# traffic does not need this. Keep empty unless hosting the UI on a separate trusted origin.
CONFIG_ALLOWED_ORIGINS=
# Optional trusted origins for cross-origin session/browser APIs.
WEB_ALLOWED_ORIGINS=
# Optional space-separated origins for direct local frontend development against api:8790.
# DEV_CORS_ORIGINS=http://localhost:5173 http://127.0.0.1:5173
# API_PORT=8790  # bound to host loopback only
# Compose private IPv4 subnet; use another private three-octet prefix if this conflicts locally.
# COMPOSE_NETWORK_PREFIX=172.30.0
# Session limits (optional; these are the defaults)
MAX_SESSIONS=6
SESSION_IDLE_S=900
RUN_TIMEOUT_S=120
RUNS_DAILY_CAP=500
# Additional process-local request and startup limits (optional)
# SESSION_START_TIMEOUT_S=45
# SESSION_START_RATE_LIMIT=10
# WEB_MUTATION_RATE_LIMIT=120
# CONFIG_WRITE_RATE_LIMIT=30
