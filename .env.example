# Copy to .env (git-ignored) and fill in. Never commit real values.
# ":80" serves plain HTTP on localhost. On the server this is <ip-with-dashes>.sslip.io.
SITE_HOST=:80
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
# OpenCode reads the provider's own variable name, and the model as provider/model.
OPENAI_API_KEY=
OPENCODE_MODEL=openai/gpt-4.1-mini
ADMIN_TOKEN=
# Bearer token the Config tab needs to save or activate a config. Empty = config writes are refused (401).
CONFIG_ADMIN_TOKEN=
# Session limits (optional; these are the defaults)
MAX_SESSIONS=6
SESSION_IDLE_S=900
RUN_TIMEOUT_S=120
RUNS_DAILY_CAP=500
