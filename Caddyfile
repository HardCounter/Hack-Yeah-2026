{$SITE_HOST} {
	# Evidence reads go to the read-only API. Config management stays in the web app so its
	# authenticated mutation routes are the only exposed configuration write path.
	@readapi {
		path /api/v1 /api/v1/*
		not path /api/v1/configs /api/v1/configs/* /api/v1/config-selection
	}
	handle @readapi {
		reverse_proxy api:8790
	}
	handle {
		reverse_proxy app:8000 {
			# keep streamed responses flowing instead of buffering them
			flush_interval -1
		}
	}
}
