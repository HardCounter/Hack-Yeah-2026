{$SITE_HOST} {
	# Read API for dashboards (docs/rest.md). The config endpoints stay in the web app: only it has
	# the shared CONFIG_DIR.
	@readapi {
		path /api/v1 /api/v1/*
		not path /api/v1/configs /api/v1/configs/* /api/v1/config-selection
	}
	handle @readapi {
		reverse_proxy api:8790
	}
	handle {
		reverse_proxy app:8000 {
			# keep streamed responses flowing instead of buffering them
			flush_interval -1
		}
	}
}
